// src/components/Contact.astro
---

<div class="mt-20 mb-10 not-prose">
    <h2 class="text-2xl font-bold text-gray-100 mb-6">Contacto</h2>
    
    <div class="p-8 bg-gray-900/50 border border-gray-800 rounded-2xl flex flex-col items-center text-center">
        <h3 class="text-xl font-bold text-gray-100 mb-3">¿Hablamos de algo interesante?</h3>
        
        <p class="text-sm text-gray-400 mb-8 max-w-md mx-auto">
            Actualmente estoy formándome en Ingeniería de Datos y siempre estoy abierto a platicar sobre tecnología, nuevos proyectos o posibles oportunidades laborales.
        </p>
        
        <!-- Botón principal Mailto -->
        <a 
            href="mailto:kaledsandoval.3@gmail.com" 
            class="px-6 py-3 bg-gray-800 text-gray-100 font-medium rounded-lg border border-gray-700 hover:border-blue-400 hover:text-blue-400 transition-colors duration-300 flex items-center gap-2 group"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-blue-400 transition-colors">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            Envíame un correo
        </a>
    </div>
</div>