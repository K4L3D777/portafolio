---
import "../styles/global.css";
import Header from "../components/Header.astro";
const {frontmatter} = Astro.props;
---

<!-- 1. Corregimos el idioma a español -->
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        
        <!-- SEO Básico -->
        <title>{frontmatter.title}</title>
        <meta name="description" content={frontmatter.description} />
        <meta name="author" content={frontmatter.author} />

        <!-- Open Graph / Facebook / LinkedIn -->
        <meta property="og:type" content="article" />
        <meta property="og:title" content={frontmatter.title} />
        <meta property="og:description" content={frontmatter.description} />
        <!-- Aquí en el futuro agregaremos og:image cuando tengas imágenes de portada -->
        
        <!-- Twitter Cards -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={frontmatter.title} />
        <meta name="twitter:description" content={frontmatter.description} />
    </head>
    <body class="bg-gray-950 p-5 md:px-0">
        <Header />
        <main class="max-w-3xl mx-auto py-10 prose prose-invert ">
            <h1>{frontmatter.title}</h1>
            
            <!-- Agregamos las clases de tu paleta para que los metadatos se vean estéticos -->
            <div class="flex gap-4 text-sm text-gray-500 mb-8 not-prose">
                <p>{frontmatter.author}</p>
                <p>&bull;</p>
                <p>{frontmatter.date}</p>
            </div>
            
            <slot />
        </main>
    </body>
</html>